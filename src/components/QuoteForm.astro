---
---

<section id="cotizar" class="relative py-20 bg-gradient-to-br from-primary to-primary-light overflow-hidden scroll-mt-20">
  <!-- Decoración de fondo -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 left-0 w-72 h-72 bg-accent rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-accent rounded-full blur-3xl translate-x-1/3 translate-y-1/3"></div>
  </div>

  <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">
        Cotizá tu seguro
      </h2>
      <p class="text-lg text-gray-300 max-w-2xl mx-auto">
        Contactanos, a la brevedad estaremos enviándotela.
      </p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-8 sm:p-10">
      <p class="text-sm text-gray-500 mb-6">Seleccioná el tipo de seguro y completá tus datos. Te responderemos a la brevedad.</p>

      <form id="quote-form" class="space-y-6">
        <!-- Selector de tipo de seguro -->
        <div class="relative">
          <label for="tipo-seguro" class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">
            Tipo de Seguro *
          </label>
          <select
            id="tipo-seguro"
            name="tipo-seguro"
            required
            class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors appearance-none bg-white cursor-pointer"
          >
            <option value="">Seleccioná el tipo de consulta</option>
            <option value="automotor">Automotor (Autos y Motos)</option>
            <option value="accidentes-personales">Accidentes Personales</option>
            <option value="hogar">Hogar</option>
            <option value="comercio-consorcio">Comercio / Consorcio</option>

          </select>
          <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 pointer-events-none" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </div>

        <!-- Campos dinámicos -->
        <div id="dynamic-fields" class="space-y-6 hidden">

          <!-- ===== DATOS DEL TOMADOR (común a todos) ===== -->
          <div id="datos-tomador" class="space-y-4 hidden">
            <h3 class="text-sm font-semibold text-primary uppercase tracking-wide border-b border-gray-200 pb-2">
              Datos del Tomador
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="relative">
                <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">Apellido y Nombre *</label>
                <input type="text" name="nombre" required placeholder="Apellido y Nombre" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 placeholder-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
              </div>
              <div class="relative">
                <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">DNI *</label>
                <input type="text" name="dni" required placeholder="DNI" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 placeholder-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
              </div>
              <div class="relative">
                <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">Fecha de Nacimiento *</label>
                <input type="date" name="fecha-nacimiento" required class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
              </div>
              <div class="relative" id="field-lugar-guarda">
                <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent" id="label-lugar">Lugar de Guarda y Uso *</label>
                <input type="text" name="lugar" required placeholder="Localidad" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 placeholder-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
              </div>
            </div>
          </div>

          <!-- ===== CAMPOS AUTOMOTOR ===== -->
          <div id="campos-automotor" class="space-y-4 hidden">
            <div class="relative sm:col-span-2">
              <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">Forma de Pago *</label>
              <select name="forma-pago" required class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors appearance-none bg-white">
                <option value="">Seleccioná forma de pago</option>
                <option value="efectivo">Efectivo</option>
                <option value="debito-automatico">Débito Automático</option>
              </select>
            </div>

            <h3 class="text-sm font-semibold text-primary uppercase tracking-wide border-b border-gray-200 pb-2">
              Datos del Vehículo
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="relative">
                <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">Marca *</label>
                <input type="text" name="marca" required placeholder="Marca" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 placeholder-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
              </div>
              <div class="relative">
                <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">Modelo *</label>
                <input type="text" name="modelo" required placeholder="Modelo" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 placeholder-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
              </div>
              <div class="relative">
                <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">Año *</label>
                <input type="number" name="anio" required placeholder="Año" min="1990" max="2027" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 placeholder-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
              </div>
              <div class="relative">
                <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">Dominio (Patente)</label>
                <input type="text" name="dominio" placeholder="ABC 123 (opcional)" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 placeholder-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
              </div>
            </div>
          </div>

          <!-- ===== CAMPOS ACCIDENTES PERSONALES ===== -->
          <div id="campos-accidentes" class="space-y-4 hidden">
            <h3 class="text-sm font-semibold text-primary uppercase tracking-wide border-b border-gray-200 pb-2">
              Riesgo a Cubrir
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="relative">
                <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">Actividad Desarrollada *</label>
                <input type="text" name="actividad" required placeholder="Actividad desarrollada" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 placeholder-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
              </div>
              <div class="relative">
                <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">Vigencia *</label>
                <input type="text" name="vigencia" required placeholder="Ej: 12 meses" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 placeholder-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
              </div>
              <div class="relative sm:col-span-2">
                <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">¿Usa moto/vehículo para movilidad? *</label>
                <select name="uso-moto" required class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors appearance-none bg-white">
                  <option value="">Seleccioná una opción</option>
                  <option value="si">Sí</option>
                  <option value="no">No</option>
                </select>
              </div>
            </div>
          </div>

          <!-- ===== CAMPOS HOGAR ===== -->
          <div id="campos-hogar" class="space-y-4 hidden">
            <h3 class="text-sm font-semibold text-primary uppercase tracking-wide border-b border-gray-200 pb-2">
              Datos del Inmueble
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="relative">
                <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">M² Cubiertos Construidos *</label>
                <input type="number" name="metros" required placeholder="M² construidos" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 placeholder-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
              </div>
              <div class="relative">
                <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">Tipo de Pared y Techos *</label>
                <input type="text" name="pared-techos" required placeholder="Ej: Ladrillo y losa" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 placeholder-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
              </div>
              <div class="relative">
                <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">¿Puerta de Seguridad? *</label>
                <select name="puerta-seguridad" required class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors appearance-none bg-white">
                  <option value="">Seleccioná</option>
                  <option value="si">Sí</option>
                  <option value="no">No</option>
                </select>
              </div>
              <div class="relative">
                <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">Alarma *</label>
                <select name="alarma" required class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors appearance-none bg-white">
                  <option value="">Seleccioná</option>
                  <option value="monitoreada">Monitoreada</option>
                  <option value="sonora">Sonora</option>
                  <option value="sin-alarma">Sin alarma</option>
                </select>
              </div>
              <div class="relative sm:col-span-2">
                <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">Tipo de Vivienda *</label>
                <select name="tipo-vivienda" required class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors appearance-none bg-white">
                  <option value="">Seleccioná</option>
                  <option value="casa">Casa</option>
                  <option value="departamento">Departamento en altura</option>
                </select>
              </div>
            </div>
          </div>

          <!-- ===== CAMPOS COMERCIO / CONSORCIO ===== -->
          <div id="campos-comercio" class="space-y-4 hidden">
            <h3 class="text-sm font-semibold text-primary uppercase tracking-wide border-b border-gray-200 pb-2">
              Datos del Inmueble / Comercio
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="relative">
                <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">M² Cubiertos Construidos *</label>
                <input type="number" name="metros-comercio" required placeholder="M² construidos" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 placeholder-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
              </div>
              <div class="relative">
                <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">Tipo de Pared y Techos *</label>
                <input type="text" name="pared-techos-comercio" required placeholder="Ej: Ladrillo y losa" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 placeholder-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
              </div>
              <div class="relative sm:col-span-2">
                <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">Actividad Comercial Desarrollada *</label>
                <input type="text" name="actividad-comercial" required placeholder="Actividad comercial" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 placeholder-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
              </div>
            </div>
          </div>



          <!-- ===== EMAIL Y CELULAR DE CONTACTO (común a todos) ===== -->
          <div id="campo-email" class="hidden">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="relative">
                <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">Email de contacto *</label>
                <input type="email" name="email" required placeholder="Email de contacto" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 placeholder-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
              </div>
              <div class="relative">
                <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">Celular *</label>
                <input type="tel" name="celular" required placeholder="Ej: 280 4XX-XXXX" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 placeholder-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
              </div>
            </div>
          </div>

          <!-- ===== COMENTARIOS (común a todos) ===== -->
          <div id="campo-comentarios" class="hidden">
            <div class="relative">
              <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">Comentarios</label>
              <textarea name="comentarios" rows="3" placeholder="Comentarios adicionales" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 placeholder-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors resize-none"></textarea>
            </div>
          </div>

          <!-- ===== BOTÓN ENVIAR ===== -->
          <div id="campo-submit" class="hidden">
            <button
              type="submit"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-accent hover:bg-accent-hover text-white font-semibold px-8 py-3.5 rounded-full transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
              </svg>
              Enviar Solicitud
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const select = document.getElementById('tipo-seguro') as HTMLSelectElement;
    const dynamicFields = document.getElementById('dynamic-fields')!;
    const datosTomador = document.getElementById('datos-tomador')!;
    const camposAutomotor = document.getElementById('campos-automotor')!;
    const camposAccidentes = document.getElementById('campos-accidentes')!;
    const camposHogar = document.getElementById('campos-hogar')!;
    const camposComercio = document.getElementById('campos-comercio')!;
    const campoEmail = document.getElementById('campo-email')!;
    const campoComentarios = document.getElementById('campo-comentarios')!;
    const campoSubmit = document.getElementById('campo-submit')!;
    const labelLugar = document.getElementById('label-lugar')!;
    const fieldLugarGuarda = document.getElementById('field-lugar-guarda')!;

    // Todos los bloques específicos
    const allSpecific = [camposAutomotor, camposAccidentes, camposHogar, camposComercio];

    function hideAll() {
      dynamicFields.classList.add('hidden');
      datosTomador.classList.add('hidden');
      campoEmail.classList.add('hidden');
      campoComentarios.classList.add('hidden');
      campoSubmit.classList.add('hidden');
      allSpecific.forEach(el => el.classList.add('hidden'));

      // Remover required de campos ocultos
      dynamicFields.querySelectorAll('[required]').forEach(el => {
        el.removeAttribute('required');
      });
    }

    function showCommon() {
      dynamicFields.classList.remove('hidden');
      datosTomador.classList.remove('hidden');
      campoEmail.classList.remove('hidden');
      campoComentarios.classList.remove('hidden');
      campoSubmit.classList.remove('hidden');

      // Agregar required a campos comunes visibles
      datosTomador.querySelectorAll('input').forEach(el => {
        el.setAttribute('required', '');
      });
      campoEmail.querySelectorAll('input').forEach(el => {
        el.setAttribute('required', '');
      });
    }

    function setRequiredInSection(section: HTMLElement) {
      section.querySelectorAll('input, select').forEach(el => {
        if ((el as HTMLElement).closest('[class*="hidden"]') === null) {
          el.setAttribute('required', '');
        }
      });
    }

    select.addEventListener('change', () => {
      hideAll();
      const value = select.value;

      if (!value) return;

      showCommon();

      switch (value) {
        case 'automotor':
          labelLugar.textContent = 'Lugar de Guarda y Uso *';
          fieldLugarGuarda.classList.remove('hidden');
          camposAutomotor.classList.remove('hidden');
          setRequiredInSection(camposAutomotor);
          break;

        case 'accidentes-personales':
          labelLugar.textContent = 'Lugar de Riesgo *';
          fieldLugarGuarda.classList.remove('hidden');
          camposAccidentes.classList.remove('hidden');
          setRequiredInSection(camposAccidentes);
          break;

        case 'hogar':
          labelLugar.textContent = 'Lugar de Riesgo *';
          fieldLugarGuarda.classList.remove('hidden');
          camposHogar.classList.remove('hidden');
          setRequiredInSection(camposHogar);
          break;

        case 'comercio-consorcio':
          labelLugar.textContent = 'Lugar de Riesgo *';
          fieldLugarGuarda.classList.remove('hidden');
          camposComercio.classList.remove('hidden');
          setRequiredInSection(camposComercio);
          break;


      }

      // Animación suave
      dynamicFields.style.opacity = '0';
      dynamicFields.style.transform = 'translateY(10px)';
      requestAnimationFrame(() => {
        dynamicFields.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
        dynamicFields.style.opacity = '1';
        dynamicFields.style.transform = 'translateY(0)';
      });
    });

    // Envío del formulario por WhatsApp
    const form = document.getElementById('quote-form') as HTMLFormElement;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const tipo = select.options[select.selectedIndex].text;

      let mensaje = `*Solicitud de Cotizaci\u00F3n*\n\n`;
      mensaje += `*Tipo de Seguro:* ${tipo}\n\n`;
      mensaje += `*Datos del Tomador:*\n`;
      mensaje += `- Nombre: ${formData.get('nombre')}\n`;
      mensaje += `- DNI: ${formData.get('dni')}\n`;
      mensaje += `- Fecha Nac.: ${formData.get('fecha-nacimiento')}\n`;
      mensaje += `- Lugar: ${formData.get('lugar')}\n`;

      const value = select.value;

      if (value === 'automotor') {
        mensaje += `- Forma de Pago: ${formData.get('forma-pago')}\n\n`;
        mensaje += `*Datos del Veh\u00EDculo:*\n`;
        mensaje += `- Marca: ${formData.get('marca')}\n`;
        mensaje += `- Modelo: ${formData.get('modelo')}\n`;
        mensaje += `- A\u00F1o: ${formData.get('anio')}\n`;
        const dominio = formData.get('dominio');
        if (dominio) {
          mensaje += `- Dominio: ${dominio}\n`;
        }
      } else if (value === 'accidentes-personales') {
        mensaje += `\n*Riesgo a Cubrir:*\n`;
        mensaje += `- Actividad: ${formData.get('actividad')}\n`;
        mensaje += `- Vigencia: ${formData.get('vigencia')}\n`;
        mensaje += `- Usa moto/veh\u00EDculo: ${formData.get('uso-moto')}\n`;
      } else if (value === 'hogar') {
        mensaje += `\n*Datos del Inmueble:*\n`;
        mensaje += `- M\u00B2 Cubiertos: ${formData.get('metros')}\n`;
        mensaje += `- Pared/Techos: ${formData.get('pared-techos')}\n`;
        mensaje += `- Puerta Seguridad: ${formData.get('puerta-seguridad')}\n`;
        mensaje += `- Alarma: ${formData.get('alarma')}\n`;
        mensaje += `- Tipo Vivienda: ${formData.get('tipo-vivienda')}\n`;
      } else if (value === 'comercio-consorcio') {
        mensaje += `\n*Datos del Comercio:*\n`;
        mensaje += `- M\u00B2 Cubiertos: ${formData.get('metros-comercio')}\n`;
        mensaje += `- Pared/Techos: ${formData.get('pared-techos-comercio')}\n`;
        mensaje += `- Actividad Comercial: ${formData.get('actividad-comercial')}\n`;
      }


      mensaje += `\n*Email:* ${formData.get('email')}\n`;
      mensaje += `*Celular:* ${formData.get('celular')}\n`;

      const comentarios = formData.get('comentarios');
      if (comentarios) {
        mensaje += `\n*Comentarios:* ${comentarios}\n`;
      }

      const encoded = encodeURIComponent(mensaje);
      window.open(`https://wa.me/5492804010957?text=${encoded}`, '_blank');
    });
  });
</script>
