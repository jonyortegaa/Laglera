---
import { company } from '../data/company';

const mapsEmbedURL = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2900.5!2d-65.0382!3d-42.7692!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2sSalta+56%2C+Puerto+Madryn!5e0!3m2!1ses!2sar!4v1";
const mapsExternalURL = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(company.address.full)}`;
---

<section id="sucursal" class="py-20 bg-white scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <h2 class="text-3xl sm:text-4xl font-bold text-primary mb-4">Nuestra Sucursal</h2>
      <p class="text-gray-600 text-lg max-w-2xl mx-auto">
        Visitanos en nuestra oficina para recibir atención personalizada y asesoramiento en seguros.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-10 items-center">
      <!-- Info -->
      <div class="space-y-6">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 bg-accent/10 rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-primary text-lg">Dirección</h3>
            <p class="text-gray-600">{company.address.full}</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-12 h-12 bg-accent/10 rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-primary text-lg">Horario de Atención</h3>
            <p class="text-gray-600">{company.hours}</p>
          </div>
        </div>

        <div id="contacto" class="flex items-start gap-4 scroll-mt-20">
          <div class="w-12 h-12 bg-accent/10 rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-primary text-lg">Contacto</h3>
            <p class="text-gray-600">
              <a href={`tel:${company.phone}`} class="hover:text-accent transition-colors">{company.phone}</a>
            </p>
            <p class="text-gray-600">
              <a href={`mailto:${company.email}`} class="hover:text-accent transition-colors">{company.email}</a>
            </p>
          </div>
        </div>
      </div>

      <!-- Map -->
      <div class="rounded-xl overflow-hidden shadow-lg h-80 bg-neutral-100">
        <iframe
          src={mapsEmbedURL}
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Ubicación de Laglera Asesores de Seguros en Google Maps"
          class="w-full h-full"
        ></iframe>
        <!-- Fallback si el iframe no carga -->
        <noscript>
          <div class="flex items-center justify-center h-full bg-neutral-100 p-6 text-center">
            <div>
              <p class="text-gray-600 mb-3">{company.address.full}</p>
              <a
                href={mapsExternalURL}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent hover:text-accent-hover font-medium underline"
              >
                Ver en Google Maps
              </a>
            </div>
          </div>
        </noscript>
      </div>
    </div>
  </div>
</section>
