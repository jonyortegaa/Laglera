---
---

<section id="consultas" class="relative py-20 bg-gradient-to-br from-primary to-primary-light overflow-hidden scroll-mt-20">
  <!-- Decoración de fondo -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 left-0 w-72 h-72 bg-accent rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-accent rounded-full blur-3xl translate-x-1/3 translate-y-1/3"></div>
  </div>

  <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">
        Consultas Generales
      </h2>
      <p class="text-lg text-gray-300 max-w-2xl mx-auto">
        ¿Tenés alguna duda? Escribinos y te respondemos a la brevedad.
      </p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-8 sm:p-10">

      <form id="general-inquiry-form" class="space-y-6">
        <div class="space-y-4">
          <h3 class="text-sm font-semibold text-primary uppercase tracking-wide border-b border-gray-200 pb-2">
            Datos de Contacto
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="relative">
              <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">Apellido y Nombre *</label>
              <input type="text" name="nombre-consulta" required placeholder="Apellido y Nombre" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 placeholder-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
            </div>
            <div class="relative">
              <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">Celular *</label>
              <input type="tel" name="celular-consulta" required placeholder="Ej: 280 4XX-XXXX" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 placeholder-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
            </div>
            <div class="relative">
              <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">Email *</label>
              <input type="email" name="email-consulta" required placeholder="Email de contacto" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 placeholder-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
            </div>
            <div class="relative">
              <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">Rubro a cotizar *</label>
              <input type="text" name="rubro-consulta" required placeholder="Rubro a cotizar" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 placeholder-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" />
            </div>
            <div class="relative sm:col-span-2">
              <label class="absolute -top-2.5 left-3 bg-white px-1 text-xs font-medium text-accent">Motivo de Consulta *</label>
              <textarea name="motivo-consulta" rows="3" required placeholder="Describí brevemente tu consulta" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-700 placeholder-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors resize-none"></textarea>
            </div>
          </div>
        </div>

        <!-- Botón Enviar -->
        <div>
          <button
            type="submit"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-accent hover:bg-accent-hover text-white font-semibold px-8 py-3.5 rounded-full transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
            </svg>
            Enviar Solicitud
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('general-inquiry-form') as HTMLFormElement;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form);

      let mensaje = `*Consulta General*\n\n`;
      mensaje += `*Datos de Contacto:*\n`;
      mensaje += `- Nombre: ${formData.get('nombre-consulta')}\n`;
      mensaje += `- Celular: ${formData.get('celular-consulta')}\n`;
      mensaje += `- Email: ${formData.get('email-consulta')}\n\n`;
      mensaje += `*Rubro a cotizar:* ${formData.get('rubro-consulta')}\n`;
      mensaje += `*Motivo de consulta:* ${formData.get('motivo-consulta')}\n`;

      const encoded = encodeURIComponent(mensaje);
      window.open(`https://wa.me/5492804010957?text=${encoded}`, '_blank');
    });
  });
</script>
