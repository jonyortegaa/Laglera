---
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
import { company } from '../data/company';

interface Props {
  title: string;
  description: string;
  headline: string;
  subtitle: string;
  coverages?: string[];
  benefits?: string[];
  plans?: { name: string; details: string[] }[];
  extraInfo?: string;
}

const { title, headline, subtitle, description, coverages = [], benefits = [], plans = [], extraInfo } = Astro.props;

const navItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Seguros', href: '/#seguros' },
  { label: 'Sucursal', href: '/#sucursal' },
  { label: 'Contacto', href: '/#contacto' },
];
---

<Layout title={`${title} | ${company.name}`} description={description}>
  <!-- Header with navigation back to home -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-[#001F3F]">
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      <a href="/" class="flex-shrink-0" aria-label="Ir al inicio">
        <img
          src="/Laglera_Seguros-removebg-preview.png"
          alt="Laglera Asesores de Seguros"
          class="h-14 w-auto"
        />
      </a>

      <ul class="hidden md:flex items-center gap-8">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-sm font-medium text-white/70 hover:text-white transition-colors duration-200"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <a
        href={company.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:inline-flex items-center gap-2 bg-accent hover:bg-accent-hover text-white font-semibold px-5 py-2.5 rounded-full transition-colors duration-200 text-sm"
      >
        Cotizá ahora
      </a>

      <button
        id="service-menu-toggle"
        class="md:hidden p-2 rounded-lg text-white hover:bg-white/10 transition-colors"
        aria-expanded="false"
        aria-controls="service-mobile-menu"
        aria-label="Abrir menú de navegación"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </nav>

    <div id="service-mobile-menu" class="hidden md:hidden bg-[#001F3F] border-t border-white/10">
      <ul class="px-4 py-4 space-y-3">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="block py-2 px-3 rounded-lg font-medium text-white/70 hover:text-white hover:bg-white/5 transition-colors"
            >
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a
            href={company.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="block py-2.5 px-3 bg-accent hover:bg-accent-hover text-white text-center rounded-full font-semibold transition-colors"
          >
            Cotizá ahora
          </a>
        </li>
      </ul>
    </div>
  </header>

  <main class="pt-20">
    <!-- Hero -->
    <section class="bg-gradient-to-br from-primary to-primary-light text-white py-24 sm:py-32">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-3xl sm:text-5xl font-bold mb-6">{headline}</h1>
        <p class="text-lg sm:text-xl text-white/80 max-w-2xl mx-auto">{subtitle}</p>
      </div>
    </section>

    <!-- Content -->
    <section class="py-20 sm:py-28">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        
        {coverages.length > 0 && (
          <div class="mb-16">
            <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-8">Coberturas</h2>
            <div class="grid sm:grid-cols-2 gap-5">
              {coverages.map((item) => (
                <div class="flex items-start gap-3 p-5 bg-neutral-50 rounded-xl">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                  </svg>
                  <span class="text-gray-700">{item}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        {benefits.length > 0 && (
          <div class="mb-16">
            <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-8">Beneficios</h2>
            <div class="grid sm:grid-cols-2 gap-5">
              {benefits.map((item) => (
                <div class="flex items-start gap-3 p-5 bg-accent/5 rounded-xl border border-accent/10">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
                  </svg>
                  <span class="text-gray-700">{item}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        {plans.length > 0 && (
          <div class="mb-16">
            <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-8">Planes</h2>
            <div class="grid sm:grid-cols-2 gap-8">
              {plans.map((plan) => (
                <div class="bg-white border border-gray-200 rounded-xl p-8 shadow-sm">
                  <h3 class="text-lg font-semibold text-primary mb-5">{plan.name}</h3>
                  <ul class="space-y-3">
                    {plan.details.map((detail) => (
                      <li class="flex items-start gap-2 text-gray-600 text-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-accent flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                        </svg>
                        <span>{detail}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        )}

        {extraInfo && (
          <div class="mb-16 p-8 bg-neutral-50 rounded-xl border border-gray-100">
            <p class="text-gray-700 leading-relaxed">{extraInfo}</p>
          </div>
        )}

        <!-- CTA -->
        <div class="text-center bg-gradient-to-r from-accent/5 to-accent/10 rounded-2xl p-10 sm:p-12 border border-accent/10">
          <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-4">¿Te interesa este seguro?</h2>
          <p class="text-gray-600 mb-8">Contactanos y te asesoramos sin compromiso.</p>
          <a
            href={company.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-accent hover:bg-accent-hover text-white font-semibold px-8 py-3.5 rounded-full transition-colors duration-300 text-lg"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
            </svg>
            Consultá por WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const menuButton = document.getElementById('service-menu-toggle');
    const mobileMenu = document.getElementById('service-mobile-menu');

    if (!menuButton || !mobileMenu) return;

    menuButton.addEventListener('click', () => {
      const isOpen = !mobileMenu.classList.contains('hidden');
      mobileMenu.classList.toggle('hidden');
      menuButton.setAttribute('aria-expanded', String(!isOpen));
    });

    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        menuButton.setAttribute('aria-expanded', 'false');
      });
    });
  });
</script>
