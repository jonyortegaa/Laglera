      <h3 class="text-xl sm:text-2xl font-bold text-primary mb-1">Seguros Personas</h3>
      <div class="w-14 h-[3px] bg-accent mb-8 rounded-full"></div>

      <div class="relative flex items-center group/carousel">
        <button class="carousel-prev absolute left-0 z-10 w-9 h-9 bg-primary/90 rounded-full flex items-center justify-center text-white hover:bg-accent transition-all duration-300 shadow-lg opacity-0 group-hover/carousel:opacity-100 -translate-x-1/2" aria-label="Anterior" data-carousel="personas">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
        </button>

        <div class="overflow-hidden w-full carousel-container py-2" data-carousel="personas">
          <div class="carousel-track flex transition-transform duration-700 ease-in-out" data-carousel="personas">
            {personas.map((item) => (
              <div class="carousel-item flex-shrink-0 px-2" data-carousel="personas">
                <div class="bg-gray-50 rounded-2xl border border-gray-100 p-5 text-center hover:shadow-lg hover:border-accent/30 hover:-translate-y-1 transition-all duration-300 cursor-pointer w-[130px] sm:w-[150px] h-[140px] flex flex-col items-center justify-center">
                  <div class="w-14 h-14 mx-auto mb-3 flex items-center justify-center text-accent">
                    <Fragment set:html={item.icon} />
                  </div>
                  <p class="text-xs sm:text-sm font-medium text-gray-700 leading-tight">{item.title}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <button class="carousel-next absolute right-0 z-10 w-9 h-9 bg-accent/90 rounded-full flex items-center justify-center text-white hover:bg-primary transition-all duration-300 shadow-lg opacity-0 group-hover/carousel:opacity-100 translate-x-1/2" aria-label="Siguiente" data-carousel="personas">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
        </button>
      </div>
    </div>

    <!-- Seguros Empresas -->
