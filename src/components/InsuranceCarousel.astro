<section id="seguros" class="pt-12 pb-20 bg-white scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-2">Cubrimos cada una de tus necesidades</h2>
    <div class="w-14 h-[3px] bg-accent rounded-full mb-10"></div>

    <!-- Seguros Personas -->
